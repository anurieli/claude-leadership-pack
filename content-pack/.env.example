# Content Pack — environment variables
# Copy to .env and fill in. Never commit .env.

# Required for extract-reel
GEMINI_API_KEY=

# Optional for podcast-to-guide (Whisper fallback when YouTube auto-subs missing)
OPENAI_API_KEY=

# Optional for podcast-to-guide. Defaults to ~/podcast-guides/
PODCAST_GUIDE_DIR=

# Optional for launch-repo. Skip any platform you don't want to post to.
# Twitter / X
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Discord
DISCORD_WEBHOOK_URL=
